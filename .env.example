# Environment variables example for Sharp AI

# Server
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Sentry (optional)
SENTRY_DSN=

# Other toggles
# Set LOG_LEVEL to info|debug|warn|error (default: info)
LOG_LEVEL=info
